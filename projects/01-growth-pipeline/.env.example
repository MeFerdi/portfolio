NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379

# Anthropic (only used via src/llm/client.ts)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Voyage AI embeddings for example-message retrieval. Leave empty to draft without examples.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
DRAFT_EXAMPLES_K=3

# Ideal customer profile definition (copy config/icp.example.json and edit)
ICP_PATH=config/icp.example.json

WORKER_CONCURRENCY=4

# Identify the bot honestly and give site owners a contact URL.
SCRAPER_USER_AGENT=GrowthPipelineBot/0.1 (+https://example.com/bot)
SCRAPER_TIMEOUT_MS=15000
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
