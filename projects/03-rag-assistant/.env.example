# All optional: with nothing set the app runs on the in-memory store with the
# lexical hashing embedder, and only the LLM-backed /ask path needs a key.

# Answering model, LLM reranker and faithfulness judge (src/llm/client.ts).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Embeddings. Without a key the hashing embedder is used (dev/CI only).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# memory | pg
VECTOR_STORE=memory
DATABASE_URL=postgres://postgres@localhost:5432/rag

# identity | llm
RERANKER=identity
# Not-in-corpus gate (best cosine). Defaults per embedder; calibrate with `npm run eval`.
# MIN_RELEVANCE_SCORE=0.35

PORT=3000
LOG_LEVEL=info
