NODE_ENV=development
LOG_LEVEL=info
PORT=3000

DATABASE_URL=postgres://postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379

# Optional: without it the diagnose worker cannot call the model (simulate.ts uses a template unless --llm).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Optional: without it emails are printed to stdout by ConsoleMailer.
RESEND_API_KEY=
MAIL_FROM="Onboarding <onboarding@example.com>"

EXPERIMENT_SALT=onboarding-recovery-2026q4
EXPERIMENT_INTERVENTION_SHARE=0.5
STALL_SCAN_EVERY_MS=900000
STALL_LOOKBACK_DAYS=30

# Optional future sink (adapter is a skeleton):
# POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_PROJECT_API_KEY=
