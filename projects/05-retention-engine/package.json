{
  "name": "onboarding-retention-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Closed-loop onboarding engine: track new-user events, detect stalls, draft AI recovery interventions, deliver idempotently, and measure intervention vs control.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "workers": "tsx src/workers/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "simulate": "tsx scripts/simulate.ts",
    "measure": "tsx scripts/measure.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "INTEGRATION=1 jest test/integration",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bullmq": "^6.3.11",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
