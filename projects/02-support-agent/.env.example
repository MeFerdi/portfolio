NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# Only needed to talk to a real model. Tests never need it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Permission model knobs
PENDING_ACTION_TTL_SECONDS=300
TOOL_RATE_LIMIT_CAPACITY=10
TOOL_RATE_LIMIT_REFILL_PER_MINUTE=6
AGENT_MAX_STEPS=6
